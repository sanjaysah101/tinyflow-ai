# ────────────────────────────────────────────────────────────
# Mozilla Otari Gateway (MozFest 2026 Hackathon)
# ────────────────────────────────────────────────────────────
OTARI_API_KEY=your_otari_api_key_here
OTARI_BASE_URL=https://api.otari.ai/v1
OTARI_USER_BUDGET_LIMIT_USD=1.00

# Optional Open-Weight Model Overrides
# Router (default: meta-llama/llama-3.2-3b-instruct)
OTARI_ROUTER_MODEL=meta-llama/llama-3.2-3b-instruct

# Specialist (default: Qwen/Qwen2.5-Coder-7B-Instruct)
OTARI_SPECIALIST_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# Synthesizer (default: mistralai/Mistral-7B-Instruct-v0.3)
OTARI_SYNTHESIZER_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Embedding for RAG (default: nomic-ai/nomic-embed-text-v1.5)
OTARI_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# ────────────────────────────────────────────────────────────
# Database & Supabase Configuration
# ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
DATABASE_URL=postgresql://postgres.your-project:password@aws-1-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project:password@aws-1-region.pooler.supabase.com:5432/postgres

# ────────────────────────────────────────────────────────────
# Legacy OpenRouter Fallback Key (optional)
# ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_legacy_openrouter_api_key_here

